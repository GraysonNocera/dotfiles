#!/usr/bin/env bash
set -e

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Map each dotfile (relative to this repo) to its destination.
# Top-level files go under $HOME; config/ mirrors ~/.config.
LINKS=(
  "zshrc:$HOME/.zshrc"
  "bashrc:$HOME/.bashrc"
  "tmux.conf:$HOME/.tmux.conf"
  "ideavimrc:$HOME/.ideavimrc"
  "vimrc:$HOME/.vimrc"
  "gitconfig:$HOME/.gitconfig"
  "ssh_rc:$HOME/.ssh/rc"
  "config/nvim:$HOME/.config/nvim"
  "config/git/ignore:$HOME/.config/git/ignore"
  "config/git/stack.sh:$HOME/.config/git/stack.sh"
  "config/lazygit/config.yml:$HOME/.config/lazygit/config.yml"
  "config/hunk/config.toml:$HOME/.config/hunk/config.toml"
)

# On macOS lazygit ignores ~/.config unless XDG_CONFIG_HOME is set.
if [ "$(uname)" = "Darwin" ]; then
  LINKS+=("config/lazygit/config.yml:$HOME/Library/Application Support/lazygit/config.yml")
fi

link() {
  local src="$1"
  local dest="$2"

  # Make sure the destination's parent directory exists (e.g. ~/.ssh).
  mkdir -p "$(dirname "$dest")"

  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    echo "Backing up existing file: $dest -> $dest.bak"
    mv "$dest" "$dest.bak"
  fi

  echo "Linking $src -> $dest"
  # -n: replace an existing link to a directory instead of linking inside it.
  ln -sfn "$src" "$dest"
}

for entry in "${LINKS[@]}"; do
  src="${entry%%:*}"
  dest="${entry#*:}"
  link "$DOTFILES/$src" "$dest"
done

# Install tmux plugin manager (tpm) if it isn't already present.
TPM_DIR="$HOME/.tmux/plugins/tpm"
if [ ! -d "$TPM_DIR" ]; then
  echo "Installing tmux plugin manager (tpm)..."
  git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi

echo "Symlinked dotfiles successfully."
